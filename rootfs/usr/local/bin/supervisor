#!/bin/sh
#
# PID 1 supervisor for rtorrent-flood-openvpn.
#
# Boot order:
#   1. Prepare /config and /output (copy defaults if absent).
#   2. Resolve the VPN endpoint(s) while outbound DNS still works, then
#      install a fail-closed iptables kill-switch BEFORE anything can leak:
#        - OUTPUT policy DROP
#        - allow loopback, established/related, the VPN tunnel (tun+),
#          and the (numeric) VPN server endpoint(s) only.
#   3. Start OpenVPN. Nothing else is started until the tunnel is up AND
#      verified to actually carry traffic (external IP reachable).
#   4. Once healthy, start rtorrent, flood and nginx.
#   5. Supervise: restart dead services, reconnect OpenVPN, keep the
#      kill-switch in place and refresh the external-IP file.
#
# Because the OUTPUT chain defaults to DROP, a VPN outage physically
# removes connectivity: traffic can never fall back to the physical NIC.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export TERM=xterm

VPN_CONF=/config/vpn/client.conf
VPN_RUN_DIR=/run/openvpn
VPN_EFFECTIVE_CONF="${VPN_RUN_DIR}/client.conf"
VPN_ENDPOINTS="${VPN_RUN_DIR}/endpoints"
VPN_LOG=/config/vpn/openvpn.log
MY_IP_FILE=/config/my-external-ip.txt

RECONNECT_DELAY=5
RECONNECT_DELAY_MAX=30
CHECK_INTERVAL=10

OPENVPN_PID=""
RTORRENT_PID=""
FLOOD_PID=""
NGINX_PID=""

STATE="booting"          # booting | waiting | ready | degraded
LAST_IP_REFRESH=0

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

die() {
    log "FATAL: $*"
    exit 1
}

is_running() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Preparation
# ---------------------------------------------------------------------------

prepare_config() {
    /usr/local/bin/prepare-config.sh || die "config preparation failed"
}

# ---------------------------------------------------------------------------
# Kill-switch
# ---------------------------------------------------------------------------

apply_kill_switch() {
    /usr/local/bin/kill-switch.sh apply "$VPN_ENDPOINTS" \
        || die "failed to apply network kill-switch (need --cap-add NET_ADMIN / --privileged)"
}

kill_switch_in_place() {
    iptables -w -C OUTPUT -o tun+ -j ACCEPT >/dev/null 2>&1
}

ensure_kill_switch() {
    if ! kill_switch_in_place; then
        log "kill-switch rules missing, re-applying"
        apply_kill_switch
    fi
}

# ---------------------------------------------------------------------------
# VPN endpoint resolution + effective config
# ---------------------------------------------------------------------------

resolve_endpoints() {
    mkdir -p "$VPN_RUN_DIR"
    : > "$VPN_ENDPOINTS"
    [ -r "$VPN_CONF" ] || return 1

    # default protocol
    PROTO=$(awk '/^[[:space:]]*proto[[:space:]]/{print $2; exit}' "$VPN_CONF")
    [ -n "$PROTO" ] || PROTO="udp"

    awk '/^[[:space:]]*remote[[:space:]]/{print $2, $3, "'"$PROTO"'"}' "$VPN_CONF" |
    while read -r HOST PORT P; do
        [ -n "$PORT" ] || PORT=1194
        case "$HOST" in
            *[!0-9.]*) # hostname
                RESOLVED=$(getent ahostsv4 "$HOST" 2>/dev/null | awk '{print $1}' | sort -u)
                for IP in $RESOLVED; do
                    echo "$P $IP $PORT" >> "$VPN_ENDPOINTS"
                done
                ;;
            *) # literal IPv4 address
                echo "$P $HOST $PORT" >> "$VPN_ENDPOINTS"
                ;;
        esac
    done

    # keep at least the entries even if nothing was parsed
    return 0
}

# Generate an effective openvpn config with:
#  - deprecated/removed directives stripped
#  - remote/proto normalised to numeric endpoints (no DNS dependency on reconnect)
#  - full-tunnel behaviour forced
#  - resolv.conf managed through /usr/bin/up.sh & /usr/bin/down.sh
generate_effective_config() {
    mkdir -p "$VPN_RUN_DIR"
    FIRST_ENDPOINT=$(head -n1 "$VPN_ENDPOINTS")
    # shellcheck disable=SC2086
    set -- $FIRST_ENDPOINT
    EPROTO=$1; EIP=$2; EPORT=$3

    HAS_COMP=0
    if grep -qE '^[[:space:]]*(comp-lzo|compress)' "$VPN_CONF"; then
        HAS_COMP=1
    fi

    # Strip directives removed from OpenVPN >= 2.4/2.5 and anything we
    # override ourselves, then rebuild the connection stanza below.
    grep -vE '^[[:space:]]*(remote|proto|resolv-retry|comp-lzo|comp-noadapt|keysize|ns-cert-type|fragment|block-outside-dns|tun-mtu|mssfix|sndbuf|rcvbuf|up[[:space:]]|down[[:space:]])' \
        "$VPN_CONF" > "${VPN_RUN_DIR}/client.conf.base"

    {
        cat "${VPN_RUN_DIR}/client.conf.base"
        printf '\n# --- generated by supervisor ---\n'
        if [ -n "$EIP" ]; then
            printf 'remote %s %s\n' "$EIP" "$EPORT"
            printf 'proto %s\n' "$EPROTO"
        fi
        printf 'resolv-retry infinite\n'
        printf 'redirect-gateway def1\n'
        if [ "$HAS_COMP" -eq 1 ]; then
            printf 'allow-compression asym\n'
        fi
        printf 'up /usr/bin/up.sh\n'
        printf 'down /usr/bin/down.sh\n'
        printf 'script-security 2\n'
    } > "$VPN_EFFECTIVE_CONF"
}

start_openvpn() {
    [ -r "$VPN_CONF" ] || { log "no $VPN_CONF yet, waiting"; return 1; }

    # make sure we have a resolvable/numeric endpoint before we start,
    # refreshing the endpoint cache from the live config if needed
    if [ ! -s "$VPN_ENDPOINTS" ]; then
        resolve_endpoints
    fi
    generate_effective_config

    if ! grep -q '^remote ' "$VPN_EFFECTIVE_CONF"; then
        if [ "${NO_REMOTE_WARNED:-0}" -eq 0 ]; then
            log "WARNING: $VPN_CONF has no reachable 'remote <host|ip> <port>' entry; fix it and restart the container"
            NO_REMOTE_WARNED=1
        fi
        return 1
    fi
    NO_REMOTE_WARNED=0

    log "starting OpenVPN (effective config $VPN_EFFECTIVE_CONF)"
    touch "$VPN_LOG"
    openvpn --suppress-timestamps --config "$VPN_EFFECTIVE_CONF" \
        >> /var/log/openvpn.log 2>&1 &
    OPENVPN_PID=$!
    log "OpenVPN started (pid $OPENVPN_PID)"
}

stop_openvpn() {
    if [ -n "$OPENVPN_PID" ] && is_running "$OPENVPN_PID"; then
        log "stopping OpenVPN (pid $OPENVPN_PID)"
        kill -TERM "$OPENVPN_PID" 2>/dev/null
        i=0
        while is_running "$OPENVPN_PID" && [ "$i" -lt 15 ]; do
            sleep 1; i=$((i + 1))
        done
        kill -KILL "$OPENVPN_PID" 2>/dev/null
    fi
    OPENVPN_PID=""
}

# ---------------------------------------------------------------------------
# Tunnel health
# ---------------------------------------------------------------------------

tunnel_iface() {
    ip -o link show 2>/dev/null | awk '$2 ~ /^tun[0-9]+:/{gsub(":","",$2); print $2; exit}'
}

tunnel_ready() {
    IF=$(tunnel_iface)
    [ -n "$IF" ] || return 1
    # any route actually using the tunnel interface (redirect-gateway def1
    # installs 0.0.0.0/1 + 128.0.0.0/1 via tun, not a plain "default")
    ip route show 2>/dev/null | grep -q "dev $IF " || return 1
    return 0
}

fetch_external_ip() {
    curl -fsS --max-time 8 -A "rtorrent-flood-openvpn-healthcheck" https://ifconfig.co/ip 2>/dev/null
}

refresh_external_ip() {
    IP=$(fetch_external_ip) || return 1
    # shellcheck disable=SC2181
    if [ -n "$IP" ]; then
        printf '%s\n' "$IP" > "${MY_IP_FILE}.tmp" && mv "${MY_IP_FILE}.tmp" "$MY_IP_FILE"
        return 0
    fi
    return 1
}

wait_for_tunnel() {
    log "waiting for VPN tunnel"
    TRY=0
    while [ "$TRY" -lt 180 ]; do
        if tunnel_ready && refresh_external_ip; then
            log "VPN tunnel is up, external IP: $(cat "$MY_IP_FILE" 2>/dev/null)"
            return 0
        fi
        if ! is_running "$OPENVPN_PID"; then
            log "OpenVPN process died, restarting"
            start_openvpn || return 1
        fi
        sleep 2
        TRY=$((TRY + 1))
    done
    log "timed out waiting for VPN tunnel"
    return 1
}

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------

# rtorrent renames its process "rtorrent main", so match on the command line
rtorrent_running() {
    pgrep -f '/usr/bin/rtorrent' >/dev/null 2>&1
}

start_rtorrent() {
    if rtorrent_running; then
        return 0
    fi
    # screen needs a writable socket dir (mode 700) for the rtorrent user
    SCREEN_DIR=/home/rtorrent/.screen
    mkdir -p "$SCREEN_DIR"
    chown rtorrent:rtorrent "$SCREEN_DIR"
    chmod 700 "$SCREEN_DIR"
    log "starting rtorrent"
    su rtorrent -s /bin/sh -c \
        "export SCREENDIR='$SCREEN_DIR'; export TERM=xterm; \
         screen -dmS rtorrent /usr/bin/rtorrent -n -o import=/config/rtorrent/rtorrent.rc" \
        >> /var/log/rtorrent.log 2>&1
    sleep 2
    if rtorrent_running; then
        log "rtorrent started"
    else
        log "WARNING: rtorrent failed to start"
    fi
}

stop_rtorrent() {
    log "stopping rtorrent"
    su rtorrent -s /bin/sh -c \
        "export SCREENDIR=/home/rtorrent/.screen; screen -S rtorrent -X quit" >/dev/null 2>&1
    sleep 2
    pkill -f '/usr/bin/rtorrent' 2>/dev/null
}

start_flood() {
    if is_running "$FLOOD_PID"; then
        return 0
    fi
    log "starting flood"
    (
        set -a
        FLOOD_OPTION_rundir=/config/flood
        FLOOD_OPTION_host=127.0.0.1
        FLOOD_OPTION_port=3000
        FLOOD_OPTION_auth=none
        FLOOD_OPTION_rthost=127.0.0.1
        FLOOD_OPTION_rtport=5000
        FLOOD_OPTION_allowedpath=/output,/config/flood
        # allow advanced users to override via /config/flood/flood.env
        [ -r /config/flood/flood.env ] && . /config/flood/flood.env
        set +a
        exec su rtorrent -s /bin/sh -c "exec /usr/local/bin/flood"
    ) >> /var/log/flood.log 2>&1 &
    FLOOD_PID=$!
    log "flood started (pid $FLOOD_PID)"
}

stop_flood() {
    if is_running "$FLOOD_PID"; then
        log "stopping flood (pid $FLOOD_PID)"
        kill -TERM "$FLOOD_PID" 2>/dev/null
    fi
    FLOOD_PID=""
}

start_nginx() {
    if is_running "$NGINX_PID"; then
        return 0
    fi
    log "starting nginx"
    nginx -g 'daemon off;' >> /var/log/nginx/error.log 2>&1 &
    NGINX_PID=$!
    log "nginx started (pid $NGINX_PID)"
}

stop_nginx() {
    if is_running "$NGINX_PID"; then
        log "stopping nginx (pid $NGINX_PID)"
        kill -TERM "$NGINX_PID" 2>/dev/null
    fi
    NGINX_PID=""
}

ensure_services() {
    # rtorrent is only (re)started once the tunnel is healthy. If the tunnel
    # is down, a running instance is left alone (blocked from the network by
    # the kill-switch) but a dead one is not restarted until connectivity
    # returns. flood + nginx bind loopback only, so they always stay up.
    if tunnel_ready; then
        start_rtorrent
    fi
    start_flood
    start_nginx
}

# ---------------------------------------------------------------------------
# Shutdown
# ---------------------------------------------------------------------------

shutdown() {
    log "shutting down"
    trap - INT TERM
    stop_flood
    stop_nginx
    stop_rtorrent
    stop_openvpn
    log "bye"
    exit 0
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

trap shutdown INT TERM

log "=============================================="
log "rtorrent-flood-openvpn supervisor starting"
log "=============================================="

prepare_config

# Resolve the VPN endpoint(s) *before* locking the network down, so the
# (numeric) server addresses can be allow-listed for OpenVPN.
resolve_endpoints

apply_kill_switch
log "kill-switch active: all non-VPN outbound traffic is blocked"

# Start nginx + flood immediately so the (local) web UI is reachable even
# before the tunnel is up; both bind loopback / are proxied over loopback.
start_nginx
start_flood

start_openvpn

if wait_for_tunnel; then
    STATE="ready"
    ensure_services
else
    STATE="waiting"
    log "VPN not connected yet; will keep retrying"
fi

LAST_IP_REFRESH=$(date +%s)

while :; do
    sleep "$CHECK_INTERVAL"

    # keep the firewall fail-closed
    ensure_kill_switch

    if tunnel_ready; then
        if [ "$STATE" != "ready" ]; then
            log "VPN tunnel (re)established"
            STATE="ready"
        fi

        # refresh the external-IP file roughly every 60s (legacy cron job)
        NOW=$(date +%s)
        if [ $((NOW - LAST_IP_REFRESH)) -ge 60 ]; then
            if refresh_external_ip; then
                LAST_IP_REFRESH=$NOW
            else
                log "WARNING: could not reach external IP service"
            fi
        fi
    else
        # tunnel is down: kill-switch guarantees no connectivity
        if [ "$STATE" = "ready" ]; then
            log "VPN tunnel lost - network is fail-closed (no connectivity until reconnect)"
            STATE="degraded"
        fi

        if ! is_running "$OPENVPN_PID"; then
            log "OpenVPN not running, reconnecting in ${RECONNECT_DELAY}s"
            sleep "$RECONNECT_DELAY"
            # start_openvpn re-resolves endpoints only when the cache is
            # empty; re-resolving here would need (blocked) DNS
            start_openvpn || log "failed to start OpenVPN"
        fi
    fi

    # keep the UI (and rtorrent, once the tunnel is healthy) alive
    ensure_services
done
